.ruff_cache/

# Local workspace configuration and credentials.
.agents/
.codex/
.aws/
.env
.env.*
.DS_Store

# Data and generated results are local. Keep directory instructions in Git.
/data/**
!/data/**/
!/data/**/README.md
!/data/**/.gitkeep
/outputs/**
!/outputs/README.md
!/outputs/.gitkeep

